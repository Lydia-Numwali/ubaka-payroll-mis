# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ubaka_attendance
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_MAX_CONNECTIONS=10

# SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM_ADDRESS=noreply@ubaka.com

# JWT Configuration
JWT_SECRET=your-secret-key-change-this-in-production
JWT_EXPIRES_IN=24h

# Fingerprint Scanner
SCANNER_SDK_PATH=./resources/sdk
SCANNER_MATCH_THRESHOLD=0.85
SCANNER_CAPTURE_TIMEOUT=10000

# Logging
LOG_LEVEL=debug
LOG_DIR=./logs
